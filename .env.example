# Web app: a URL reachable by every browser/phone using this instance.
# Convex Cloud: https://your-deployment.convex.cloud
# Self-hosted Convex: http://your-server:3210 (use HTTPS for remote access)
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
APP_PORT=3000

# Optional runtime override for portable Docker images:
# CONVEX_URL="https://your-deployment.convex.cloud"

# One-shot backend setup job (docker-compose.convex.yml --profile setup):
# the exact app origin browsers will use, and a production deploy key that
# you pass on the command line rather than storing here.
# SITE_URL="http://192.168.1.20:3000"

# Backend configuration belongs on CONVEX, not in the web container. The setup
# job sets all of the following; the manual commands are for the CLI path.
# pnpm exec convex env set SITE_URL 'https://kitchen.example.com'
# pnpm exec convex env set RESEND_API_KEY 'your-key'              (optional)
# pnpm exec convex env set SMTP_FROM 'Kitchen <you@your-domain>' (optional)
# pnpm exec convex env set SECRETS_ENCRYPTION_KEY '<base64-32-byte-key>' (optional AI)
# APP_BASE_URL is a legacy override; if set on Convex, keep it equal to SITE_URL.
# Deploy/admin keys belong only in the operator's CLI/CI environment.
