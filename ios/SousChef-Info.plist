<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Self-hosted kitchens often run on plain HTTP inside a home network or
	     tailnet. The app warns before sending credentials over HTTP to a
	     non-local host; see ios/README.md for the App Review note. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The recipe community used when no Sous Chef server is connected and no
	     custom community address is set. Switch this to the production
	     community (https://<deployment>.convex.site) before release. -->
	<key>SousChefCommunityURL</key>
	<string>https://silent-gerbil-530.convex.site</string>
	<!-- Recipe screens advertise this activity so Siri knows which recipe
	     "this recipe" means. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.georgevina.souschef.recipe</string>
	</array>
	<!-- CloudKit pushes wake the app so iCloud changes arrive promptly. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
