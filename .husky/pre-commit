echo "🔍 Running type check..."
npm run type-check

if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Please fix the errors before committing."
  exit 1
fi

echo "✅ Type check passed!"

echo "🧪 Running tests..."
npm run test

if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Please fix the failures before committing."
  exit 1
fi

echo "✅ Tests passed!"
