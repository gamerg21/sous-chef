# Local kitchen: no database service or Convex account required.
SOUS_CHEF_DATA_DIR=./data
APP_PORT=3000
# Exact browser-facing origin (required behind an HTTPS reverse proxy).
# APP_URL=https://kitchen.example.com
SOUS_CHEF_ALLOW_SIGNUP=true
SOUS_CHEF_DEMO=false
# Optional community service, operated independently of this kitchen.
# COMMUNITY_API_URL=https://your-deployment.convex.site
# COMMUNITY_CONVEX_URL=https://your-deployment.convex.cloud
# Optional local password reset email. Without it, use the operator command.
# RESEND_API_KEY=re_xxx
# SMTP_FROM=Kitchen <kitchen@example.com>
# Encryption key is generated in the data directory. Preserve it with backups.
# Supply SECRETS_ENCRYPTION_KEY only when restoring an existing external key.
