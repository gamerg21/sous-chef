# Sous Chef home server (docker-compose.homelab.yml)
# ./homelab.sh copies this to .env.homelab and fills SERVER_HOST for you.

# REQUIRED. The LAN IP or hostname other devices use to reach this machine.
# Every browser and phone must be able to open http://SERVER_HOST:3000 and
# http://SERVER_HOST:3210. Do not use localhost or 127.0.0.1 here.
SERVER_HOST=192.168.1.20

# Host ports (change only if something else already uses them).
APP_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791

# Pin the Convex backend + dashboard images to one release for repeatable
# upgrades: https://github.com/get-convex/convex-backend/releases
# CONVEX_BACKEND_TAG=precompiled-2026-09-04-390fe4d

# Reverse proxy / HTTPS. When Caddy, nginx, or Traefik terminates TLS, set the
# exact browser-facing origins here and keep them in sync with your proxy.
# APP_URL=https://kitchen.example.com
# CONVEX_PUBLIC_URL=https://convex.kitchen.example.com
# CONVEX_SITE_URL=https://convex-site.kitchen.example.com

# Optional password-reset email through Resend (verified sender required).
# RESEND_API_KEY=re_xxx
# SMTP_FROM=Kitchen <kitchen@your-verified-domain.com>

# Where ./homelab.sh backup writes exports.
BACKUP_DIR=./backups

# Prebuilt images instead of building this checkout (pin a tag you trust).
# SOUS_CHEF_IMAGE=ghcr.io/gamerg21/sous-chef:v0.3.0
# SOUS_CHEF_SETUP_IMAGE=ghcr.io/gamerg21/sous-chef-setup:v0.3.0

# Convex backend options: opt out of anonymous usage beacon, reduce retention.
# DISABLE_BEACON=1
# DOCUMENT_RETENTION_DELAY=172800
